# =================================================================
# MR - K Distribution — Variables d'environnement
# =================================================================
# Copiez ce fichier en .env (local) ou configurez les variables
# dans votre plateforme d'hébergement (Vercel, etc.).
#
# Ne JAMAIS committer le fichier .env dans git.
# =================================================================

# --- Base de données ---
# SQLite (dev local) : fichier dans ./db/
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Pour Vercel production, utilisez Turso (SQLite over HTTP) :
# 1. Créez un compte sur https://turso.tech
# 2. Créez une base de données
# 3. Récupérez l'URL et le token
# 4. Installez le driver : bun add @libsql/client
# 5. Changez le provider dans prisma/schema.prisma de "sqlite" à "postgresql"
#    ou utilisez le adaptateur libsql (voir prisma docs)
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"

# --- Authentification admin ---
# Mot de passe admin (choisir un mot de passe fort, 12+ caractères)
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret pour signer les sessions admin (32+ caractères hex)
# Générer avec : openssl rand -hex 32
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32-please-change-this"

# --- Environnement ---
NODE_ENV="development"
# En production : NODE_ENV="production"
