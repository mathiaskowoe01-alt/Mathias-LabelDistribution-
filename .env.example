# =================================================================
# Mathias Label — Variables d'environnement
# =================================================================
# Configurez ces variables sur Vercel (Project Settings -> Environment Variables)
# et localement dans votre fichier .env.
# =================================================================

# --- Base de données PostgreSQL (Supabase) ---
# DATABASE_URL : Pooler Supabase en mode Transaction (port 6543 avec ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL : Pooler Supabase en mode Session pour migrations Prisma (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Authentification admin ---
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32-please-change-this"

# --- Environnement ---
NODE_ENV="production"

# --- Supabase API & Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
